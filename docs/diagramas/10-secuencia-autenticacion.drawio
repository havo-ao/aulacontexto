="sourcePoint"/><mxPoint x="350" y="84" as="targetPoint"/></mxGeometry></mxCell><mxCell id="7" value="2. POST /auth/login" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="118" as="sourcePoint"/><mxPoint x="580" y="118" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="3. Busca usuario y rol" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="152" as="sourcePoint"/><mxPoint x="810" y="152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="9" value="4. Usuario (hash de contraseña, rol)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="186" as="sourcePoint"/><mxPoint x="580" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="10" value="5. Verifica el hash (bcrypt)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="220" as="sourcePoint"/><mxPoint x="580" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="11" value="6. JWT firmado (rol, expiración 8 h)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="254" as="sourcePoint"/><mxPoint x="350" y="254" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="7. GET /cursos · Authorization: Bearer" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="288" as="sourcePoint"/><mxPoint x="580" y="288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="8. Valida firma, vigencia y rol" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="322" as="sourcePoint"/><mxPoint x="580" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="9. Consulta solo los cursos del docente" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="356" as="sourcePoint"/><mxPoint x="810" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="10. Datos del docente autenticado" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#171B19;fontSize=13;fontFamily=Helvetica;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="390" as="sourcePoint"/><mxPoint x="350" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="16" value="Contraseñas con hash bcrypt; el token solo viaja por HTTPS; cada docente accede únicamente a sus cursos y trabajos (paso 9)." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#4A524D;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="860" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>