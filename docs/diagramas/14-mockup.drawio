<mxfile host="app.diagrams.net"><diagram name="Mockup conceptual" id="d1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#0E6B6B;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;AulaConTexto&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#171B19;whiteSpace=wrap;align=left;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="28" width="300" height="24" as="geometry"/></mxCell><mxCell id="4" value="Docente: M. Pérez · Matemáticas 8.º · Cerrar sesión" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#171B19;whiteSpace=wrap;align=right;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="28" width="290" height="24" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Contexto del curso&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="480" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Objetivos&lt;/b&gt;&lt;br&gt;Resolver ecuaciones lineales de una variable y modelar situaciones con ellas." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F4F5F2;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="230" height="70" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;Materiales (texto)&lt;/b&gt;&lt;br&gt;Guía de ecuaciones · Plan de área · Ejemplos resueltos" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F4F5F2;" vertex="1" parent="1"><mxGeometry x="30" y="175" width="230" height="90" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;Rúbrica · 4 criterios&lt;/b&gt;&lt;br&gt;Planteamiento (30 %)&lt;br&gt;Procedimiento (30 %)&lt;br&gt;Resultado (20 %)&lt;br&gt;Comunicación (20 %)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#F4F5F2;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="230" height="150" as="geometry"/></mxCell><mxCell id="9" value="Editar contexto" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;arcSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="230" height="30" as="geometry"/></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="640" height="480" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;Unidad 3 · Plan de clase&lt;/b&gt; &amp;nbsp;&amp;nbsp; Estado: &lt;font color=&quot;#A8332B&quot;&gt;&lt;b&gt;Borrador pendiente de validación&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#171B19;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="620" height="24" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;Objetivo de la sesión&lt;/b&gt;&lt;br&gt;Al finalizar, el estudiante plantea y resuelve ecuaciones lineales a partir de situaciones cotidianas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Inicio (10 min)&lt;/b&gt; Situación problema: presupuesto de una salida escolar.&lt;br&gt;&lt;b&gt;Desarrollo (30 min)&lt;/b&gt; Trabajo en parejas con la guía de ecuaciones; tres ejercicios graduados.&lt;br&gt;&lt;b&gt;Cierre (10 min)&lt;/b&gt; Socialización y verificación con el criterio Procedimiento de la rúbrica.&lt;br&gt;&lt;br&gt;&lt;i&gt;Texto generado a partir del contexto del curso. El docente puede editarlo antes de aprobar.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FAFAF8;" vertex="1" parent="1"><mxGeometry x="290" y="105" width="620" height="300" as="geometry"/></mxCell><mxCell id="13" value="Regenerar" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;arcSize=20;" vertex="1" parent="1"><mxGeometry x="290" y="420" width="120" height="34" as="geometry"/></mxCell><mxCell id="14" value="Editar" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#4A524D;fillColor=#FFFFFF;fontColor=#171B19;arcSize=20;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="120" height="34" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Aprobar y publicar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeColor=#0E6B6B;fillColor=#0E6B6B;fontColor=#FFFFFF;arcSize=20;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="160" height="34" as="geometry"/></mxCell><mxCell id="16" value="Al aprobar se guarda la versión 1 con fecha y docente responsable. Nada se publica al curso sin este paso." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#4A524D;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="470" width="620" height="50" as="geometry"/></mxCell><mxCell id="17" value="Mockup conceptual de baja fidelidad: pantalla principal del docente con el contexto del curso a la izquierda y el borrador generado a la derecha." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#4A524D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="900" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>