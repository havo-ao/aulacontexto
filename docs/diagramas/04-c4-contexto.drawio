<mxfile host="app.diagrams.net"><diagram name="C4 nivel 1 · Contexto" id="d1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;Docente&lt;/b&gt;&lt;br&gt;Define el contexto de su curso, genera y valida" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#171B19;fontColor=#171B19;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="40" height="60" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Coordinador académico&lt;/b&gt;&lt;br&gt;Consulta planes aprobados" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#171B19;fontColor=#171B19;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="40" height="60" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;AulaConTexto&lt;/b&gt;&lt;br&gt;[Sistema a construir]&lt;br&gt;Genera planes y retroalimentación a partir del contexto que define el docente y los somete a su validación" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#0E6B6B;fillColor=#0E6B6B;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="260" height="110" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;API de modelo de lenguaje&lt;/b&gt;&lt;br&gt;[Sistema externo]&lt;br&gt;Genera texto a partir del prompt" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#7C847E;fillColor=#8A9490;fontColor=#FFFFFF;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="6" value="Carga contexto, genera, valida [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A524D;fontSize=11;fontColor=#4A524D;" edge="1" parent="1" source="2" target="4"><mxGeometry relati